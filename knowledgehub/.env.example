# ===== KnowledgeHub 环境配置 =====
# 使用方式：复制本文件为 .env 并填写密钥；.env 已被 .gitignore 排除，绝不入库。

# --- Docker Compose 端口映射 ---
MONGO_PORT=27017
REDIS_PORT=6379
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091

# --- Neo4j 初始账号（密码至少 8 位） ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=knowledgehub123

# --- 后端连接串（宿主机直连容器端口） ---
# MongoDB 为单节点副本集；directConnection=true 绕过副本集发现
# （副本集成员注册名为容器名 mongodb:27017，宿主机不可解析）
MONGO_URI=mongodb://localhost:27017/?directConnection=true
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
MILVUS_URI=http://localhost:19530

# --- 硅基流动模型服务（设计文档 §9.8 / §12 定稿方案） ---
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
# 向量维度：定稿前为 0；定稿后必须写死（64/256/512/768/1024/1536/2048/2560/4096 离散档位，
# 建议 1024 或 2048）。定稿后任何模型/维度变更 = 全量重建 Milvus Collection（硬约束 §9.8.3）
EMBEDDING_DIM=0
RERANKER_MODEL=Qwen/Qwen3-Reranker-8B
# LLM 独立端点（可选）：缺省走硅基流动（与 Embedding 同 Key）；
# 切官方 DeepSeek API 示例：LLM_API_BASE=https://api.deepseek.com
#                       LLM_API_KEY=sk-你的DeepSeek密钥
#                       LLM_MODEL=deepseek-chat
LLM_API_BASE=
LLM_API_KEY=
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
