<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '44px 64px 36px 64px', display: 'flex', flexDirection: 'column' }}>

    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#526BEA', letterSpacing: 2 }}>01 / 项目背景 · 标杆对比</Text>
        <Text style={{ fontSize: 11, color: '#667792' }}>对标对象：Obsidian · Zotero · ima</Text>
    </Box>

    <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#1B2A44', marginTop: 6, lineHeight: 1.3 }}>三个标杆各做对一段，没有一款打通整条链路</Text>
    <Text style={{ fontSize: 14, color: '#667792', marginTop: 8, lineHeight: 1.6 }}>对标不是为了复刻功能，而是找出它们各自留白的那一段 —— 我们把四段接起来，并且让它可测。</Text>

    <Box style={{ flexDirection: 'row', marginTop: 22 }}>
        <Box style={{ flexDirection: 'column', width: 208 }}>
            <Box style={{ height: 50, justifyContent: 'flex-end', paddingBottom: 11 }}>
                <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#667792' }}>能力维度</Text>
            </Box>
            {['多格式资料入库', '笔记与双向链接', '关系图谱可视化', '语义检索', '出处与原文回溯', '索引自建与可实验'].map((d, i) => (
                <Box key={i} style={{ height: 54, justifyContent: 'center', borderBottom: i === 5 ? 'none' : '1px solid #E5EAF3' }}>
                    <Text style={{ fontSize: 14, color: '#1B2A44' }}>{d}</Text>
                </Box>
            ))}
        </Box>

        {[
            {
                name: 'Obsidian', sub: '本地 Markdown', width: 236,
                headBg: '#F6F8FC', headColor: '#1B2A44', subColor: '#667792',
                bodyBg: 'transparent', border: '#E5EAF3', cellColor: '#3A4863',
                cells: [['◐', '靠插件', '#EFA942'], ['●', '原生', '#16AE9C'], ['●', '全局图谱', '#16AE9C'], ['◐', '靠插件', '#EFA942'], ['○', '无页码', '#9AA7BC'], ['○', '不可介入', '#9AA7BC']]
            },
            {
                name: 'Zotero', sub: '文献与引文管理', width: 236,
                headBg: '#F6F8FC', headColor: '#1B2A44', subColor: '#667792',
                bodyBg: 'transparent', border: '#E5EAF3', cellColor: '#3A4863',
                cells: [['◐', '仅文献', '#EFA942'], ['○', '无', '#9AA7BC'], ['○', '无', '#9AA7BC'], ['○', '仅关键词', '#9AA7BC'], ['●', '页码 + 引文', '#16AE9C'], ['○', '不可介入', '#9AA7BC']]
            },
            {
                name: 'ima', sub: '腾讯 AI 知识库', width: 236,
                headBg: '#F6F8FC', headColor: '#1B2A44', subColor: '#667792',
                bodyBg: 'transparent', border: '#E5EAF3', cellColor: '#3A4863',
                cells: [['●', '19+ 格式', '#16AE9C'], ['◐', '2026.07 补齐', '#EFA942'], ['○', '无', '#9AA7BC'], ['●', '大模型问答', '#16AE9C'], ['●', '原文溯源', '#16AE9C'], ['○', '云端托管', '#9AA7BC']]
            },
            {
                name: '知序（本项目）', sub: '异构 NoSQL 协同', width: 236,
                headBg: '#526BEA', headColor: '#FFFFFF', subColor: '#D9DFFC',
                bodyBg: '#EEF2F9', border: '#DCE4F5', cellColor: '#1B2A44',
                cells: [['●', '原生解析', '#16AE9C'], ['●', '原生双链', '#16AE9C'], ['●', '局部 + 全局', '#16AE9C'], ['●', '向量召回', '#16AE9C'], ['●', 'Chunk 定位', '#16AE9C'], ['●', '可重建可注入', '#16AE9C']]
            }
        ].map((col, ci) => (
            <Box key={ci} style={{ flexDirection: 'column', width: col.width, background: col.bodyBg, borderRadius: 12 }}>
                <Box style={{ height: 50, width: col.width, background: col.headBg, borderRadius: '12px 12px 0 0', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: col.headColor }}>{col.name}</Text>
                    <Text style={{ fontSize: 11, color: col.subColor, marginTop: 3 }}>{col.sub}</Text>
                </Box>
                {col.cells.map((c, ri) => (
                    <Box key={ri} style={{ height: 54, justifyContent: 'center', alignItems: 'center', borderBottom: ri === 5 ? 'none' : '1px solid ' + col.border }}>
                        <Text style={{ fontSize: 13, color: col.cellColor }}>
                            <span style={{ color: c[2], fontWeight: 'bold' }}>{c[0]}</span> {c[1]}
                        </Text>
                    </Box>
                ))}
            </Box>
        ))}
    </Box>

    <Box style={{ marginTop: 20, background: '#1B2A44', borderRadius: 12, padding: '16px 24px', flexDirection: 'row', alignItems: 'center' }}>
        <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#16AE9C', letterSpacing: 1, width: 104 }}>本项目的位置</Text>
        <Text style={{ fontSize: 14, color: '#FFFFFF', lineHeight: 1.6, flex: 1 }}>把四段接成一条闭环 —— 资料进得来、笔记连得起来、语义搜得到、出处点得回去；并且索引可重建、可注入故障做实验。</Text>
    </Box>

    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginTop: 12 }}>
        <Text style={{ fontSize: 11, color: '#667792' }}>● 原生具备　　◐ 需插件 / 能力较弱　　○ 不具备</Text>
        <Text style={{ fontSize: 11, color: '#9AA7BC' }}>判定依据：产品公开文档 + 2026.10 实测</Text>
    </Box>

</Slide>
